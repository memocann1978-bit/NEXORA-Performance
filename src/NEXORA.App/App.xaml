<Application x:Class="NEXORA.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#090811"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#151222"/>
    <SolidColorBrush x:Key="PanelLightBrush" Color="#211A35"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F04462"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#9B5CFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F8F5FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A69BBE"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F04462" Offset="0"/><GradientStop Color="#A34DFF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D1730" Offset="0"/><GradientStop Color="#12101E" Offset="1"/></LinearGradientBrush>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource PanelLightBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,12"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="#342747" BorderThickness="1"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#352044"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A34DFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,3,0,3"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="#C9C0DA"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#251B38"/><Setter TargetName="NavBorder" Property="BorderBrush" Value="#53336F"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#382044"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>