<Window x:Class="NEXORA.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXORA Performance" Height="780" Width="1280" MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#10131A" Padding="18"><DockPanel>
      <StackPanel DockPanel.Dock="Top">
        <StackPanel Orientation="Horizontal" Margin="4,8,0,30"><Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}"><TextBlock Text="N" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="NEXORA" FontSize="19" FontWeight="Bold" /><TextBlock Text="PERFORMANCE" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
        <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>
        <Button Content="▦   Genel Bakış" Tag="dashboard" Click="Navigate_Click" Background="#29202A" Margin="0,2"/>
        <Button Content="⚡   Quick Boost" Tag="boost" Click="Navigate_Click" Margin="0,2"/>
        <Button Content="🎮   Gaming Center" Tag="gaming" Click="Navigate_Click" Margin="0,2"/>
        <TextBlock Text="MONITORING" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="8,22,0,10"/>
        <Button Content="◉   Donanım İzleme" Tag="hardware" Click="Navigate_Click" Margin="0,2"/>
        <Button Content="▤   İşlem Yöneticisi" Tag="processes" Click="Navigate_Click" Margin="0,2"/>
        <Button Content="◷   Başlangıç Uygulamaları" Tag="startup" Click="Navigate_Click" Margin="0,2"/>
        <TextBlock Text="TOOLS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="8,22,0,10"/>
        <Button Content="⌁   Windows Araçları" Tag="windows" Click="Navigate_Click" Margin="0,2"/>
        <Button Content="⚙   Ayarlar" Tag="settings" Click="Navigate_Click" Margin="0,2"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,4"><TextBlock Text="NEXORA PERFORMANCE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="BUILD 0.1.0  •  PREVIEW" Foreground="#697181" FontSize="9" Margin="0,4,0,0"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="30,24,30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,26"><StackPanel><TextBlock x:Name="PageTitle" Text="Genel Bakış" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Sisteminin durumunu tek merkezden takip et." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#171C25" CornerRadius="18" Padding="13,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="0,0,8,0"/><TextBlock Text="SİSTEM AKTİF" FontSize="10" FontWeight="Bold"/></StackPanel></Border></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageContent">
        <Border Background="#191D27" CornerRadius="14" Padding="22" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WELCOME TO NEXORA" Foreground="#F06A74" FontSize="10" FontWeight="Bold"/><TextBlock Text="Kontrol sende." FontSize="25" FontWeight="Bold" Margin="0,8,0,4"/><TextBlock Text="Donanımını tanı, sistemini yönet ve oyun deneyimini optimize et." Foreground="{StaticResource MutedBrush}"/></StackPanel><Border Grid.Column="1" Background="#302027" CornerRadius="12" Padding="18" VerticalAlignment="Center"><TextBlock Text="NEXORA / 01" Foreground="#FF8790" FontWeight="Bold"/></Border></Grid></Border>
        <UniformGrid Columns="3" Margin="0,0,0,18">
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="CPU LOAD" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="CpuValue" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock x:Name="CpuName" Text="Veri bekleniyor" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="5,0"><StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="RamValue" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock x:Name="RamDetail" Text="Veri bekleniyor" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="GPU" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="GpuValue" Text="—" FontSize="16" FontWeight="Bold" Margin="0,13,0,8" TextWrapping="Wrap"/><TextBlock Text="Model bilgisi" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Border>
        </UniformGrid>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="SİSTEM BİLGİSİ" FontSize="12" FontWeight="Bold" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions><TextBlock Text="İşletim sistemi" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OsValue" Grid.Column="1" Text="—"/><TextBlock Grid.Row="1" Text="Bilgisayar" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PcValue" Grid.Row="1" Grid.Column="1" Text="—"/><TextBlock Grid.Row="2" Text="Çalışma süresi" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UptimeValue" Grid.Row="2" Grid.Column="1" Text="—"/></Grid></StackPanel></Border>
        <Border Background="#20191D" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="GÜVENLİK NOTU" Foreground="#FF8790" FontWeight="Bold" FontSize="11"/><TextBlock Text="NEXORA sistem ayarlarını izinsiz değiştirmez. Optimizasyon işlemleri uygulanmadan önce etkileri açıklanacak ve geri alma seçenekleri sunulacaktır." Foreground="#C5AEB1" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Window>
