<Window x:Class="NEXORA.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXORA Performance" Height="900" Width="1480" MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#100D1B" BorderBrush="#29203B" BorderThickness="0,0,1,0" Padding="17">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <Border CornerRadius="16" Padding="13" Background="{StaticResource PanelGradient}" BorderBrush="#443052" BorderThickness="1" Margin="0,5,0,24">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="43" Height="43" CornerRadius="13" Background="{StaticResource AccentGradient}"><TextBlock Text="N" FontSize="27" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="NEXORA" FontSize="21" FontWeight="ExtraBold"/><TextBlock Text="PERFORMANCE SUITE" FontSize="9" Foreground="#B69BD8" FontWeight="Bold" Margin="1,2,0,0"/></StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="WORKSPACE" Foreground="#8F80AA" FontSize="10" FontWeight="Bold" Margin="9,0,0,8"/>
          <Button Style="{StaticResource NavButton}" Content="▦    Genel Bakış" Tag="dashboard" Click="Navigate_Click" Background="#30203D" Foreground="#FFFFFF"/>
          <Button Style="{StaticResource NavButton}" Content="ϟ    Quick Boost" Tag="boost" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="🎮    Gaming Center" Tag="gaming" Click="Navigate_Click"/>
          <TextBlock Text="WINDOWS CONTROL" Foreground="#8F80AA" FontSize="10" FontWeight="Bold" Margin="9,22,0,8"/>
          <Button Style="{StaticResource NavButton}" Content="▦    Uygulama Yöneticisi" Tag="apps" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⚙    Windows Tweaks" Tag="tweaks" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="🛠    Windows Onarım" Tag="repair" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▣    Windows Özellikleri" Tag="features" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▧    Debloat Manager" Tag="debloat" Click="Navigate_Click"/>
          <TextBlock Text="SYSTEM CONFIG" Foreground="#8F80AA" FontSize="10" FontWeight="Bold" Margin="9,22,0,8"/>
          <Button Style="{StaticResource NavButton}" Content="▤    Güç Planları" Tag="power" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="↻    Windows Update" Tag="updates" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⚙    Sistem Yapılandırması" Tag="config" Click="Navigate_Click"/>
          <TextBlock Text="MONITORING" Foreground="#8F80AA" FontSize="10" FontWeight="Bold" Margin="9,22,0,8"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Button Style="{StaticResource NavButton}" Content="◉    Donanım İzleme" Tag="hardware" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="▤    İşlem Yöneticisi" Tag="processes" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="◷    Başlangıç Uygulamaları" Tag="startup" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="▣    Windows Hizmetleri" Tag="services" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="▤    Depolama Temizliği" Tag="storage" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="⌁    Ağ Merkezi" Tag="network" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="▦    GPU Merkezi" Tag="gpu" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="◉    Performans Testi" Tag="benchmark" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="≡    Sistem Günlükleri" Tag="logs" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="↻    Geri Yükleme" Tag="restore" Click="Navigate_Click"/>
            <TextBlock Text="TOOLS" Foreground="#8F80AA" FontSize="10" FontWeight="Bold" Margin="9,22,0,8"/>
            <Button Style="{StaticResource NavButton}" Content="⌁    Windows Araçları" Tag="windows" Click="Navigate_Click"/>
            <Button Style="{StaticResource NavButton}" Content="⚙    Ayarlar" Tag="settings" Click="Navigate_Click"/>
          </StackPanel>
        </ScrollViewer>
        <Border DockPanel.Dock="Bottom" Background="#1B1429" CornerRadius="12" BorderBrush="#352545" BorderThickness="1" Padding="12" Margin="0,12,0,0">
          <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#54E3A2" Margin="0,0,8,0"/><TextBlock Text="SYSTEM ONLINE" FontSize="10" FontWeight="Bold" Foreground="#D8D0E7"/></StackPanel><TextBlock Text="NEXORA PERFORMANCE  •  VIP EDITION" Foreground="#8F80AA" FontSize="9" Margin="0,7,0,0"/></StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,25,30,25">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,23">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="NEXORA / CONTROL CENTER" Foreground="#B58AE8" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Genel Bakış" FontSize="30" FontWeight="ExtraBold" Margin="0,5,0,0"/><TextBlock x:Name="PageSubtitle" Text="Sisteminin durumunu tek merkezden takip et." Foreground="{StaticResource MutedBrush}" Margin="1,5,0,0"/></StackPanel>
        <Border Grid.Column="1" Background="#1B1728" BorderBrush="#49335F" BorderThickness="1" CornerRadius="18" Padding="15,10" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#54E3A2" Margin="0,0,9,0"/><TextBlock Text="SİSTEM AKTİF" FontSize="10" FontWeight="Bold"/></StackPanel></Border>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent">
          <Border Background="{StaticResource PanelGradient}" CornerRadius="20" Padding="27" Margin="0,0,0,18" BorderBrush="#50315F" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="✦  WELCOME TO NEXORA" Foreground="#FF7893" FontSize="10" FontWeight="Bold"/><TextBlock Text="Kontrol sende." FontSize="31" FontWeight="ExtraBold" Margin="0,9,0,5"/><TextBlock Text="Donanımını tanı, sistemini yönet ve oyun deneyimini kendi tarzında optimize et." Foreground="#B5A9C8" FontSize="13"/></StackPanel>
              <Border Grid.Column="1" Width="125" Height="105" CornerRadius="18" Background="{StaticResource AccentGradient}" VerticalAlignment="Center"><StackPanel VerticalAlignment="Center"><TextBlock Text="N" FontSize="58" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock Text="ELITE SYSTEM" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
            </Grid>
          </Border>
          <UniformGrid Columns="3" Margin="0,0,0,18">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="19" Margin="0,0,10,0" BorderBrush="#302443" BorderThickness="1"><StackPanel><TextBlock Text="CPU LOAD" Foreground="#B58AE8" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CpuValue" Text="—" FontSize="32" FontWeight="ExtraBold" Margin="0,8,0,2"/><TextBlock x:Name="CpuName" Text="Veri bekleniyor" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="19" Margin="5,0" BorderBrush="#302443" BorderThickness="1"><StackPanel><TextBlock Text="MEMORY USAGE" Foreground="#B58AE8" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RamValue" Text="—" FontSize="32" FontWeight="ExtraBold" Margin="0,8,0,2"/><TextBlock x:Name="RamDetail" Text="Veri bekleniyor" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="19" Margin="10,0,0,0" BorderBrush="#302443" BorderThickness="1"><StackPanel><TextBlock Text="GRAPHICS PROCESSOR" Foreground="#B58AE8" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="GpuValue" Text="—" FontSize="16" FontWeight="Bold" Margin="0,13,0,8" TextWrapping="Wrap"/><TextBlock Text="GPU model information" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Border>
          </UniformGrid>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,16" BorderBrush="#302443" BorderThickness="1"><StackPanel><TextBlock Text="SYSTEM INFORMATION" FontSize="12" FontWeight="Bold" Foreground="#D9C9F2" Margin="0,0,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions><TextBlock Text="İşletim sistemi" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OsValue" Grid.Column="1" Text="—"/><TextBlock Grid.Row="1" Text="Bilgisayar" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PcValue" Grid.Row="1" Grid.Column="1" Text="—"/><TextBlock Grid.Row="2" Text="Çalışma süresi" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UptimeValue" Grid.Row="2" Grid.Column="1" Text="—"/></Grid></StackPanel></Border>
          <Border Background="#211629" CornerRadius="15" Padding="18" BorderBrush="#633451" BorderThickness="1"><StackPanel><TextBlock Text="✦  NEXORA PROTECTION" Foreground="#FF829B" FontWeight="Bold" FontSize="11"/><TextBlock Text="NEXORA sistem ayarlarını izinsiz değiştirmez. Optimizasyon işlemleri uygulanmadan önce etkileri açıklanacak ve geri alma seçenekleri sunulacaktır." Foreground="#C8B7CE" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>